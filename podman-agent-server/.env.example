# ═══════════════════════════════════════════════════════════════════
# Podman Agent Server 配置
# 复制为 .env 并填写所需参数，未设置的项将使用默认值
# ═══════════════════════════════════════════════════════════════════

# ── LLM 连接 ──────────────────────────────────────────────────────
# API 密钥（必填）
LLM_API_KEY=sk-xxx
# API 地址，支持所有 OpenAI 兼容接口
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名称: deepseek-v4-flash(轻量快速) | deepseek-v4-pro(高能力) | 或其他兼容模型
LLM_MODEL=deepseek-v4-flash
# 单轮最大迭代步数，超过则强制结束（防止无限循环）
MAX_ITERATIONS=20
# 生成温度，越低越确定性，建议 0.0~1.0
TEMPERATURE=0.2
# 核采样概率，与 temperature 二选一调节即可（留空不传）
# TOP_P=0.95
# 单次生成最大 token 数（留空由模型端控制）
# MAX_TOKENS=4096
# 流式输出开关，true=逐字显示 / false=等待完整回复
STREAM=true
# 思考模式，仅适用于支持 enable_thinking 参数的模型（如 DeepSeek R1）
ENABLE_THINKING=false

# ── Agent 行为 ────────────────────────────────────────────────────
# 上下文 token 阈值，超过后自动裁剪历史消息以节省 token
CONTEXT_TOKEN_THRESHOLD=850000
# 裁剪历史时保留的最近消息条数
KEEP_RECENT=20
# 循环检测窗口大小，保留最近 N 轮工具调用签名用于检测重复执行
LOOP_WINDOW=4
# 每 N 轮迭代注入一次安全护栏提醒，防止 Agent 偏离任务
GUARDRAILS_INTERVAL=5

# ── Plan-Execute-Reflect 任务编排 ─────────────────────────────────
# 启用任务规划，复杂任务自动拆解为步骤列表
ENABLE_PLANNING=true
# 启用步骤反思，每步执行后自我评估结果是否达标
ENABLE_REFLECTION=true
# 每步失败后最大重试次数，0=不重试
MAX_RETRIES_PER_STEP=2

# ── LATS 候选方案搜索 ─────────────────────────────────────────────
# 启用后每步生成多个候选方案并评估选优（会增加 2× 倍 LLM 调用）
ENABLE_LATS=false
# 每步生成的候选方案数，建议 2~5
LATS_CANDIDATES=3

# ── 安全策略 ──────────────────────────────────────────────────────
# 是否允许 Agent 执行 Shell 命令，false=完全禁止
ALLOW_SHELL=true
# Shell 命令黑名单（逗号分隔），命中任一关键词则拒绝执行
SHELL_BLACKLIST=rm -rf /,rm -rf ~,mkfs,dd if=,shutdown,reboot,:(){ :|:& };:

# ── Human-in-the-Loop 人机确认 ────────────────────────────────────
# 确认模式:
#   all   — 所有工具调用均需人工确认
#   risky — 仅高危工具需确认（默认，适合日常使用）
#   none  — 直接放行，不弹确认（适合信任环境或调试）
HITL_MODE=risky
# risky 模式下需要确认的工具列表（逗号分隔）
HITL_TOOLS=run_shell,write_file,edit_file

# ── 自进化系统 (Self-Evolution) ───────────────────────
# 启用自进化，包括：对话后反思、工具模式学习、Prompt自适应、用户画像建模
ENABLE_EVOLUTION=true
# 触发反思的最小工具调用数（少于此数的简单对话不触发反思）
EVOLUTION_REFLECT_MIN_TOOLS=2
# 后台深度分析间隔（小时），启动时若超过此间隔则自动执行
EVOLUTION_ANALYSIS_INTERVAL=24
